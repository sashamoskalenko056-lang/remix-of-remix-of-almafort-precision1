# ALMAFORT — пример .env для VPS. Скопируйте в .env и заполните.
# cp .env.example .env && nano .env    (chmod 600 .env)

# --- Сервер ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
WEB_CONCURRENCY=2

# --- Backend (Lovable Cloud) — обязательные ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Серверные дубли тех же значений (используются server-функциями)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Приватный ключ бэкенда (только сервер, никогда не в браузер)
SUPABASE_SERVICE_ROLE_KEY=

# --- ИИ (адаптер src/lib/ai-provider.server.ts) ---
# Режим: openai (Рег.облако и любой OpenAI-совместимый шлюз) | lovable | gemini.
# Можно переопределить отдельно для ИИ-камеры и конфигуратора.
AI_PROVIDER=openai
#AI_PROVIDER_VISION=openai
#AI_PROVIDER_CONFIGURATOR=openai

# --- Рег.облако (Reg.ru Cloud AI), OpenAI-совместимый API ---
# Вставьте URL шлюза и сгенерированный токен — больше ничего менять не нужно.
OPENAI_BASE_URL=https://cloud.reg.ru/api/ai/v1
OPENAI_API_KEY=
# ИИ-конфигуратор (RAG): deepseek-v4-flash | claude-haiku-4.5 | gpt-5.1
OPENAI_MODEL=deepseek-v4-flash
# ИИ-камера (Vision): gemini-3.5-flash | gemini-3.1-pro
OPENAI_VISION_MODEL=gemini-3.5-flash

# Шлюз Lovable (тесты / период миграции)
LOVABLE_API_KEY=
#LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1

# Google Gemini через OpenAI-совместимый эндпоинт или свой шлюз
GEMINI_API_KEY=
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#GEMINI_MODEL=gemini-2.0-flash
#GEMINI_VISION_MODEL=gemini-2.0-flash


# --- Админ-хранилище ключей (AES-256-GCM) ---
ADMIN_VAULT_KEY=

# --- Почта: собственный SMTP (nodemailer), почтовик бэкенда не используется ---
# Боевой хост — от него строятся ссылки в письмах (сброс пароля, инвайты)
PUBLIC_SITE_URL=https://almafort.ru
SMTP_HOST=
# 465 = SSL/TLS (Яндекс, Mail.ru), 587 = STARTTLS
SMTP_PORT=465
# Необязательно: 1/true — явно включить TLS, 0/false — STARTTLS (по умолчанию из порта)
#SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ALMAFORT
# Подробный лог SMTP-сессии в PM2 (диагностика): 1
#SMTP_DEBUG=0
# Токен для служебных писем (invite / order / notice) на /api/public/send-mail
MAIL_API_TOKEN=

# --- Устаревшее (не используется) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# --- CRM ---
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
BITRIX24_WEBHOOK_URL=
CRM_QUIZ_PIPELINE_ID=
CRM_QUIZ_STAGE_ID=
CRM_QUIZ_CATEGORY_ID=

# --- Интеграции / вебхуки ---
CARRIER_WEBHOOK_TOKEN=
CATALOG_SYNC_TOKEN=
RECAPTCHA_SECRET_KEY=

# --- S3 (shadow-логи распознавания, CAD-файлы) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_CAD_BUCKET=
